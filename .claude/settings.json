{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p \"$CLAUDE_PROJECT_DIR/prompts\" && { printf '\\n## %s\\n\\n' \"$(date -u '+%Y-%m-%d %H:%M UTC')\"; jq -r '.prompt // empty'; } >> \"$CLAUDE_PROJECT_DIR/prompts/LOG.md\""
          }
        ]
      }
    ]
  }
}
